# Copy this file to .env.local for local testing (optional)
# On Vercel, set these in Project Settings → Environment Variables

# Password your son uses to log in as admin
ADMIN_PASSWORD=change-this-to-something-secret

# Random long string used to sign login tokens (generate any random text)
ADMIN_SECRET=change-this-to-a-long-random-string

# From Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
